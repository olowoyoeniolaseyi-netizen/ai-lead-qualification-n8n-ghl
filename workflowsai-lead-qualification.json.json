    {
      "parameters": {
        "jsCode": "const DEFAULT_CC = '1'; // change to '234' for Nigerian numbers\n\nreturn $input.all().map(item => {\n  const d = item.json.body ?? item.json;\n  const c = d.customData ?? {};\n\n  const first = (c.first_name || d.first_name || '').trim();\n  const last = (c.last_name || d.last_name || '').trim();\n  const email = (c.email || d.email || '').trim().toLowerCase();\n\n  // Normalize phone to +countrycode format\n  const raw = (c.phone || d.phone || '').trim();\n  let digits = raw.replace(/\\D/g, '');\n  if (raw.startsWith('+')) {\n    // already international, keep as is\n  } else if (digits.startsWith('0')) {\n    digits = DEFAULT_CC + digits.slice(1);\n  } else if (digits.length === 10) {\n    digits = DEFAULT_CC + digits;\n  }\n  const phone = digits ? '+' + digits : '';\n\n  // SMS consent: any real answer counts as ticked; empty or negative values do not\n  const consentRaw = String(c.sms_consent || d.sms_consent || '').trim().toLowerCase();\n  const consent = consentRaw !== '' && !['false', 'no', 'null', 'undefined', 'unchecked'].includes(consentRaw);\n\n  // Hard problems block the lead; soft ones only warn\n  const issues = [];\n  const warnings = [];\n  if (!first) issues.push('missing first name');\n  if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) issues.push('invalid email');\n  if (phone.length < 11) warnings.push('missing or invalid phone');\n  if (!consent) warnings.push('no SMS consent');\n\n  const message = (c.message || d.message ||\n    'Hi, I need help automating follow-ups for my small gym. How much does it cost and how soon can we start?'\n  ).trim();\n\n  return {\n    json: {\n      id: d.id || c.id || c.contact_id || d.contact_id,\n      first_name: first,\n      last_name: last,\n      email,\n      phone,\n      message,\n      consent,\n      consent_time: new Date().toISOString(),\n      consent_source: 'ghl-lead-form',\n     \n      issues,\n      warnings,\n      is_clean: issues.length === 0\n    }\n  };\n});"
      },
