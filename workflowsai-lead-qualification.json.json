      "parameters": {
        "jsCode": "const res = $input.first().json;\nconst lead = $('HTTP Request2').first().json; // your cleaning node's exact name\n\nconst text = res.candidates?.[0]?.content?.parts?.[0]?.text ?? '';\nlet parsed;\ntry {\n  parsed = JSON.parse(text.replace(/```json|```/g, '').trim());\n} catch (e) {\n  return [{ json: { ...lead, ai_ok: false, ai_error: 'unparseable output', raw: text } }];\n}\n\nconst okCategory = ['hot', 'warm', 'cold'].includes(parsed.category);\nconst okScore = Number.isInteger(parsed.score) && parsed.score >= 1 && parsed.score <= 10;\nif (!okCategory || !okScore || !parsed.reason || !parsed.suggested_reply) {\n  return [{ json: { ...lead, ai_ok: false, ai_error: 'schema mismatch', raw: text } }];\n}\n\nreturn [{ json: {\n  ...lead,\n  ai_ok: true,\n  score: parsed.score,\n  category: parsed.category,\n  reason: parsed.reason,\n  suggested_reply: parsed.suggested_reply,\n  input_tokens: res.usageMetadata?.promptTokenCount,\n  output_tokens: res.usageMetadata?.candidatesTokenCount\n} }];"
      },
